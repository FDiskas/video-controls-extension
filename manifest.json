{
  "manifest_version": 3,
  "name": "Video Frame Controls",
  "version": "0.1.0",
  "description": "Adds 10-second seek, frame-step and scrub controls to videos without native controls, like YouTube Shorts and Instagram Reels.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Video Frame Controls shortcuts",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "settings/settings.html"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  }
}
